{
  "name": "personal-blog",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "db:local": "wrangler d1 migrations apply blog --local",
    "db:remote": "wrangler d1 migrations apply blog --remote",
    "posts:seed": "node scripts/build-rank-table.mjs && node scripts/import-posts.mjs",
    "posts:export": "node scripts/export-posts.mjs",
    "posts:export:remote": "node scripts/export-posts.mjs --remote",
    "render:check": "node scripts/check-render.mjs"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.3.4",
    "@astrojs/markdown-remark": "^7.3.1",
    "astro": "^7.3.5",
    "github-slugger": "^2.0.0",
    "hast-util-to-text": "^4.0.2",
    "katex": "^0.16.47",
    "lenis": "^1.3.26",
    "rehype-katex": "^7.0.1",
    "rehype-raw": "^7.0.0",
    "rehype-stringify": "^10.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "remark-smartypants": "^3.0.3",
    "shiki": "^3.23.0",
    "tegaki": "^1.0.2",
    "unified": "^11.0.5",
    "unist-util-remove-position": "^5.0.0",
    "unist-util-visit": "^5.1.0",
    "unist-util-visit-parents": "^6.0.2",
    "vfile": "^6.0.3"
  },
  "allowScripts": {
    "esbuild": true
  },
  "devDependencies": {
    "wrangler": "^4.148.0"
  }
}
