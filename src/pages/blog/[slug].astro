---
import { env } from 'cloudflare:workers';
import Base from '../../layouts/Base.astro';
import { columnName, fmtDate, postBySlug, updatedAt } from '../../lib/posts';
import { canWrite } from '../../lib/access';
// KaTeX 按页引入：只有文章页需要公式，不往首页/列表页发
import 'katex/dist/katex.min.css';

// 正文在 D1 的 body_html 列里（保存那一刻排好的），所以这一页每次请求现查。
// 不在请求里跑 Markdown/KaTeX：那篇最长的笔记排一次要 675ms CPU。
export const prerender = false;

const post = await postBySlug(env.DB, Astro.params.slug!);
if (!post) return Astro.redirect('/blog/');

// 「编辑这篇」只给自己看：进过写作页的人有那个记号（见 agents.md 坑 16）。
// 这一页因此随登录状态变，不能被边缘按 URL 共享缓存。
const showWrite = await canWrite(Astro.request, env) || Astro.cookies.get('canwrite')?.value === '1';
if (showWrite) Astro.response.headers.set('Cache-Control', 'private, max-age=0, must-revalidate');

// 正文 HTML 是站上写作时由浏览器排好交上来的，不是服务端产的 —— 所以这一页要假定
// body_html 里可能混进能执行的东西。script-src 不给 unsafe-inline 也不给 unsafe-hashes：
// 写在内联标签里的脚本、以及 on 开头的内联事件属性都不执行，脚本只能从本站同源取。
Astro.response.headers.set('Content-Security-Policy', "script-src 'self'; object-src 'none'; base-uri 'self'");

// 手写标题组件会把字体 bundle（十几 KB）拉进来。**必须条件加载** ——
// 无条件 import 等于每篇文章都背这份体积，而全站只有一两篇用它。
// vite 会把它切成独立 chunk，没用到的文章页不会带上。
const Handwritten = post.handwritten
  ? (await import('../../components/Handwritten.astro')).default
  : null;
// 这篇属于哪个栏目（栏目名查 src/data/columns.ts），以及它的最后更新时间
const colName = columnName(post.column);
const fmt = fmtDate(updatedAt(post));
---
<Base title={`${post.title} · il7510n`} description={post.title} path={`/blog/${post.slug}/`}>
  <div class="wrap article">
    <article class="prose paper">
      <a class="backlink u" href={`/columns/${post.column}/`} data-backlink>← {colName}</a>
      {Handwritten && post.handwritten && <Handwritten text={post.handwritten} />}
      <div class="meta">
        <span>{fmt}</span>
        {showWrite && <a class="u editbtn" href={`/write/${post.column}/?slug=${post.slug}`}>编辑这篇</a>}
      </div>
      <h1>{post.title}</h1>
      <Fragment set:html={post.bodyHtml} />
    </article>
  </div>
<!-- 阅读导引：左侧标尺（一行一条刻度）+ 视口正中的阅读横线 + 光球。
       纯装饰，整层 pointer-events:none，不挡任何点击。 -->
  <div class="readguide" aria-hidden="true">
    <div class="readguide__ruler">
      <!-- 刻度条在内层：它逐帧改 transform，外层窗口只负责裁切 + 两端渐隐 -->
      <div class="readguide__track"><div class="readguide__body"></div></div>
    </div>
    <div class="readguide__line"></div>
    <!-- 光球在**正文里**，不在标尺上：它落在当前标题的左侧边距里，
         跟着那个标题的高度走。left 由 JS 按纸面位置算，top 靠 --rg-y。 -->
    <span class="readguide__ball"></span>
  </div>
</Base>
<script>
  // 阅读导引抽成共用模块（src/scripts/readguide.ts）：写作页 /write/栏目/ 用的是
  // 同一份，所以两处的标尺、红线、红球行为不会各走各的。
  import { startReadguide } from '../../scripts/readguide';

  const prose = document.querySelector<HTMLElement>('.prose');
  const guide = document.querySelector<HTMLElement>('.readguide');
  if (prose && guide) startReadguide(prose, guide);
</script>
