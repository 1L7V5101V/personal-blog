---
import Base from '../../layouts/Base.astro';
import { getCollection, render } from 'astro:content';
// KaTeX 按页引入：只有文章页需要公式，不往首页/列表页发
import 'katex/dist/katex.min.css';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((p) => ({ params: { slug: p.id }, props: { post: p } }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const d = post.data.date;
const fmt = `${d.getFullYear()}.${String(d.getMonth() + 1).padStart(2, '0')}.${String(d.getDate()).padStart(2, '0')}`;
---
<Base title={`${post.data.title} · il7510n`} description={post.data.title} path={`/blog/${post.id}/`}>
  <div class="wrap article">
    <article class="prose paper">
      <a class="backlink u" href="/blog/" data-backlink>← 全部文章</a>
      <div class="meta">
        <span>{fmt}</span>
        <span>{post.data.tag}</span>
      </div>
      <h1>{post.data.title}</h1>
      <Content />
    </article>
  </div>
<!-- 阅读导引：左侧标尺（一行一条刻度）+ 视口正中的阅读横线 + 光球。
       纯装饰，整层 pointer-events:none，不挡任何点击。 -->
  <div class="readguide" aria-hidden="true">
    <div class="readguide__ruler">
      <!-- 刻度条在内层：它逐帧改 transform，外层窗口只负责裁切 + 两端渐隐 -->
      <div class="readguide__track"><div class="readguide__body"></div></div>
    </div>
    <div class="readguide__line"></div>
    <!-- 光球在**正文里**，不在标尺上：它落在当前标题的左侧边距里，
         跟着那个标题的高度走。left 由 JS 按纸面位置算，top 靠 --rg-y。 -->
    <span class="readguide__ball"></span>
  </div>
</Base>
<script>
  // ---- 阅读导引 ----
  // 左侧标尺 = 文章的一张缩略地图，跟随阅读位置在窗口里上下滚：
  // 中心横线当前指着正文的那一行，永远对应刻度条上落在横线高度的那条刻度。
  //
  // 刻度：一条 = 正文一行；标题按层级给更长的刻度。**最长边 / 最短边固定**，
  // 中间档在两者之间按「本页实际存在的层级总数」线性插值。
  // 间距也固定（RG_GAP），所以长文章的刻度条会远长于窗口 → 两端渐隐 + 滚动。
  //
  // 光球在**正文里**，落在当前标题的左侧边距，正圆，随层级递减。
  const prose = document.querySelector<HTMLElement>('.prose');
  const guide = document.querySelector<HTMLElement>('.readguide');

  if (prose && guide) {
    const paper = prose;
    const ruler = guide.querySelector<HTMLElement>('.readguide__ruler')!;
    const track = guide.querySelector<HTMLElement>('.readguide__track')!;
    const bodyStrip = guide.querySelector<HTMLElement>('.readguide__body')!;
    const ball = guide.querySelector<HTMLElement>('.readguide__ball')!;

    const RG_MAX = 64;          // 刻度最长边（最大的标题），固定
    const RG_MIN = 22;          // 刻度最短边（正文行），固定。之前定 9 太短了：
                                // 64 vs 9 的落差让正文那一档细到看不见，
                                // 22 让「正文 / h3 / h2 / h1」四档一眼分得开
    const RG_GAP = 8;           // 刻度间距：固定小值，不随文章长度变
    const AVAIL = 0.62;         // 窗口最多占视口高度的百分比
    const BALL_EASE = 0.06;   // 光球补间速率：越小越慢（时间常数 ≈ -16.7/ln(1-rate)）
                           // 0.12 → 约 160ms，0.06 → 约 325ms
    const BALL_MAX = 16, BALL_MIN = 7;   // 光球直径：最大层级 / 最小层级
    const PREFER = 28;        // 「更大层级优先」的判定距离

    const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;

    type Head = { level: number; el: HTMLElement; top: number; h: number };
    const ticks: (number | null)[] = [];   // null = 正文行
    const tickY: number[] = [];            // 每条刻度对应的文档 Y（单调递增）
    const heads: Head[] = [];
    let levels: number[] = [];             // 本页实际存在的层级，升序
    let lineH = 27;
    let maxLen = RG_MAX;
    let winH = 0;

    // ---- 建刻度表 + 每条刻度的文档坐标 ----
    function scan() {
      ticks.length = 0;
      tickY.length = 0;
      heads.length = 0;
      lineH = parseFloat(getComputedStyle(paper).lineHeight) || 27;

      for (const el of Array.from(paper.children) as HTMLElement[]) {
        const top = el.getBoundingClientRect().top + scrollY;
        if (/^H[1-6]$/.test(el.tagName)) {
          const level = Number(el.tagName[1]);
          heads.push({ level, el, top, h: el.getBoundingClientRect().height });
          ticks.push(level);
          tickY.push(top);
        } else {
          const n = el.tagName === 'PRE'
            ? Math.max(1, (el.textContent ?? '').split('\n').length)
            : Math.max(1, Math.round(el.getBoundingClientRect().height / lineH));
          for (let i = 0; i < n; i++) {
            ticks.push(null);
            tickY.push(top + (i + 0.5) * lineH);
          }
        }
      }
      levels = [...new Set(heads.map((h) => h.level))].sort((a, b) => a - b);
    }

    // ---- 边长：固定两端 + 按层级数线性插值中间档 ----
    function tickLen(level: number | null) {
      if (level === null) return RG_MIN;
      const rank = levels.indexOf(level);              // 0 = 最大的层级
      return RG_MIN + (maxLen - RG_MIN) * ((levels.length - rank) / levels.length);
    }
    // ---- 光球直径：跟着刻度长度走，开方让层级差拉得开 ----
    function ballSize(level: number) {
      const ratio = (tickLen(level) - RG_MIN) / (maxLen - RG_MIN);
      const fr = ratio * ratio;
      return BALL_MIN + (BALL_MAX - BALL_MIN) * fr;
    }

    // ---- 当前该落在哪个标题上 ----
    function active(): Head {
      const ry = scrollY + vh / 2;   // 阅读横线的文档坐标
      let a = heads[0];
      for (const h of heads) {
        if (h.top <= ry + 1) a = h;
        else break;
      }
      // 「如果有更大层级优先落在更大层级」：更大的层级（level 更小）刚好压在
      // 横线上时，哪怕它比当前候选低，也改落它。
      for (const h of heads) {
        if (h.level < a.level && Math.abs(h.top - ry) < PREFER) return h;
      }
      return a;
    }

    // ---- 阅读位置对应的那条刻度（二分，tickY 单调递增）----
    function cursorTick(ry: number) {
      let lo = 0, hi = tickY.length - 1;
      while (lo < hi) {
        const mid = (lo + hi + 1) >> 1;
        if (tickY[mid] <= ry) lo = mid; else hi = mid - 1;
      }
      return lo;
    }

    function layout() {
      if (!ticks.length) return;
      // 最长边随视口收一收，窄屏上别撞到纸面
      maxLen = Math.round(Math.min(RG_MAX, Math.max(34, innerWidth * 0.046)));
      ruler.style.width = maxLen + 'px';

      const contentH = ticks.length * RG_GAP;
      // 窗口：短文就用内容高度（外留 32px 让渐隐有地方化），
      // 长文封顶在视口的 AVAIL —— 刻度条超出窗口的部分靠滚动看。
      winH = Math.round(Math.min(innerHeight * AVAIL, contentH + 32));
      ruler.style.height = winH + 'px';
      track.style.height = contentH + 'px';
      track.style.setProperty('--rg-gap', RG_GAP + 'px');
      bodyStrip.style.width = RG_MIN + 'px';

      // 只给**标题**刻度建 DOM：正文刻度是一条 repeating-linear-gradient（见 CSS）。
      // 369 条刻度里 350 条是正文，用 DOM 画就是白挂 350 个绝对定位元素。
      const frag = document.createDocumentFragment();
      ticks.forEach(function (lv, i) {
        if (lv === null) return;
        const el = document.createElement('i');
        el.className = 'readguide__tick';
        el.style.top = i * RG_GAP + 'px';
        el.style.width = tickLen(lv).toFixed(2) + 'px';
        frag.appendChild(el);
      });
      track.replaceChildren(bodyStrip, frag);

      // 光球的横向位置：纸面左内边距里，标题文字的左边
      const padX = parseFloat(getComputedStyle(paper).paddingLeft) || 32;
      ball.style.left = (paper.getBoundingClientRect().left + padX * 0.3).toFixed(1) + 'px';
    }

    let off = NaN;          // 刻度条位移，NaN = 首帧直接吸附
    let curY = NaN;          // 光球纵向位置，同上
    let lastBall = -1;
    let vh = innerHeight;
    let last = performance.now();

    function update() {
      if (!heads.length) return;
      const now = performance.now();
      const dt = Math.min(64, now - last);
      last = now;
      const snap = reduced || !Number.isFinite(off);

      // ---- 标尺：把「阅读位置对应的那条刻度」平移到窗口中线 ----
      // ⚠ 符号：offset > 0 是把刻度条往下推。刻度条顶边对齐窗口顶边时
      // （offset=0）刻度 0 在窗口顶部；要让第 i 条落到中线（距顶 winH/2），
      // 得往上推 i*GAP - winH/2。写反了球会往屏幕外跑。
      const ry = scrollY + vh / 2;
      const maxOff = Math.max(0, ticks.length * RG_GAP - winH);
      const want = Math.min(
        Math.max(winH / 2 - cursorTick(ry) * RG_GAP, -maxOff),
        0,
      );
      off = snap ? want : off + (want - off) * (1 - Math.pow(1 - 0.16, dt / 16.67));
      track.style.setProperty('--rg-off', off.toFixed(2) + 'px');

      // ---- 光球：严格跟随当前标题，不夹取 ----
      // 目标是该标题在视口里的垂直中心。标题一旦滚出屏幕顶端，球也跟着出去 ——
      // 这是故意的：球表示「当前在哪一节」，而不是「你在视口的哪个高度」。
      // 标题还在屏内时球就精确贴在它身上；标题出了屏，球也出屏；
      // 等下一节到来，球再滑过去。中间那段正文里，球就停在（屏外的）上一节上。
      const a = active();
      const target = a.top - scrollY + a.h / 2;
      const k = snap || !Number.isFinite(curY) ? 1 : 1 - Math.pow(1 - BALL_EASE, dt / 16.67);
      curY = snap || !Number.isFinite(curY) ? target : curY + (target - curY) * k;

      // 尺寸只在这一刻的层级真的变了时才写：改 width 会触发重排 + 重画光晕
      if (a.level !== lastBall) {
        lastBall = a.level;
        ball.style.setProperty('--rg-ball', ballSize(a.level).toFixed(1) + 'px');
      }
      ball.style.setProperty('--rg-y', curY.toFixed(2) + 'px');
    }

    scan();
    layout();
    (window as any).__fx = (window as any).__fx || [];
    (window as any).__fx.push(update);

    // resize 会重排 → 行数、窗口高度、标题坐标、光球横向位置全部要重量
    let rt = 0;
    addEventListener('resize', () => {
      clearTimeout(rt);
      rt = window.setTimeout(() => {
        vh = innerHeight;
        scan();
        layout();
        lastBall = -1;
        curY = NaN;
        off = NaN;
      }, 140);
    });
    // 字体落地后行高会变，行数跟着变
    document.fonts?.ready.then(() => { scan(); layout(); lastBall = -1; off = NaN; });
  }
</script>
