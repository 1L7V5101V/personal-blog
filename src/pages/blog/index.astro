---
import Base from '../../layouts/Base.astro';
import { allPosts, columnName, fmtDate, updatedAt } from '../../lib/posts';

// 全部文章，按各篇的最后更新时间倒序（栏目名只是标一下它属于哪一栏）
const posts = await allPosts();
---
<Base title="文章 · il7510n">
  <section class="wrap pagehead">
    <h1 data-reveal style="--i:0">文章</h1>
    <p class="count" data-reveal style="--i:1">共 {posts.length} 篇</p>
  </section>
  <section class="wrap">
    <div class="list">
      {posts.map((p, i) => (
        <a class="row" data-io style={`--i:${i % 4}`} href={`/blog/${p.id}/`} data-pt={`row:${p.id}`}>
          <span class="t">{p.data.title}</span>
          <span class="m">{columnName(p.data.column)} · {fmtDate(updatedAt(p))}</span>
        </a>
      ))}
    </div>
  </section>
</Base>
