---
import Base from '../layouts/Base.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);
const featured = posts.slice(0, 4);
const fmt = (d: Date) => `${d.getFullYear()}.${String(d.getMonth() + 1).padStart(2, '0')}.${String(d.getDate()).padStart(2, '0')}`;
---
<Base>
  <!-- Hero：排版即设计，进场逐行浮现 -->
  <section class="hero wrap">
    <h1>
      <span class="mask"><span data-reveal style="--i:0">il7510n</span></span>
    </h1>
    <p class="bio">
      <span class="mask"><span data-reveal style="--i:1">写代码，也写字。这里放慢一点，想清楚一点。</span></span>
    </p>
    <p class="hint" data-reveal style="--i:2">向下滚动 ↓</p>
  </section>

  <!-- 精选展区：钉住横滑 + 曲线描绘 + 图片三连 -->
  <section class="hwrap" id="showcase">
    <div class="hsticky">
      <svg class="hline" viewBox="0 0 1600 900" preserveAspectRatio="none" aria-hidden="true">
        <path
          pathLength="1"
          style="stroke-dasharray: 1; stroke-dashoffset: 1;"
          d="M -20 640 C 260 500, 520 780, 820 610 S 1240 430, 1640 580"
        ></path>
      </svg>
      <div class="hhead">
        <span class="label">精选 · Featured</span>
        <span class="hint">继续滚动横向浏览</span>
      </div>
      <div class="htrack">
        {featured.map((p, i) => (
          <a class="hcard" data-io style={`--i:${i}`} href={`/blog/${p.id}/`}>
            <figure>
              <div class="imgbox">
                {p.data.cover && <img src={p.data.cover} alt="" loading="lazy" />}
              </div>
              <figcaption>
                <span class="t">{p.data.title}</span>
                <span class="d">{fmt(p.data.date)}</span>
                <span class="go">→</span>
              </figcaption>
            </figure>
          </a>
        ))}
        <a class="hend u" href="/blog/">查看全部文章 →</a>
      </div>
    </div>
  </section>

  <!-- 全部文章 -->
  <section class="wrap">
    <div class="sec">
      <span class="label">全部文章</span>
      <a class="u" href="/blog/" style="color:var(--fg-2);font-size:.85rem">RSS 敬请期待</a>
    </div>
    <div class="list">
      {posts.map((p, i) => (
        <a class="row" data-io style={`--i:${i % 4}`} href={`/blog/${p.id}/`}>
          <span class="t">{p.data.title}</span>
          <span class="m">{p.data.tag} · {fmt(p.data.date)}</span>
        </a>
      ))}
    </div>
  </section>

  <!-- 宣言块 -->
  <section class="wrap manifesto" aria-label="信条">
    <p data-io style="--i:0">把字写清楚。</p>
    <p data-io style="--i:1">把代码写简单。</p>
    <p data-io style="--i:2">把东西做久。</p>
  </section>
</Base>

<style>
  .hero {
    padding-top: 26vh;
    padding-bottom: 20vh;
  }
  .hero h1 {
    margin: 0;
    font-size: clamp(3rem, 10vw, 6.5rem);
    line-height: 1.05;
  }
  .hero .bio {
    margin: 1.2rem 0 0;
    font-size: 1.05rem;
    color: var(--fg-2);
  }
  .hero .hint {
    margin-top: 6vh;
    font-size: 0.85rem;
    color: var(--fg-3);
  }
  .mask {
    display: inline-block;
    overflow: hidden;
    vertical-align: bottom;
  }
  .mask > span {
    display: inline-block;
  }
</style>

<script>
  const wrap = document.querySelector<HTMLElement>('.hwrap');
  const track = document.querySelector<HTMLElement>('.htrack');
  const curve = document.querySelector<SVGPathElement>('.hline path');
  const cards = [...document.querySelectorAll<HTMLElement>('.hcard')];
  const mobile = matchMedia('(max-width: 768px)');
  const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (wrap && track && !mobile.matches && !reduced) {
    let dist = 0;
    const measure = () => {
      dist = Math.max(0, track.scrollWidth - innerWidth);
      wrap.style.height = `calc(100svh + ${dist}px)`;
    };
    measure();
    addEventListener('resize', measure);

    (window as any).__fx = (window as any).__fx || [];
    (window as any).__fx.push(() => {
      const r = wrap.getBoundingClientRect();
      const p = dist > 0 ? Math.min(1, Math.max(0, -r.top / dist)) : 0;
      // 横滑：垂直滚动进度 → 轨道水平位移
      track.style.transform = `translate3d(${(-p * dist).toFixed(2)}px, 0, 0)`;
      // 曲线描绘：滚多少画多少
      if (curve) curve.style.strokeDashoffset = String(1 - p);
      // 图片呼吸缩放：距视口中心越近越饱满
      for (const card of cards) {
        const cr = card.getBoundingClientRect();
        const center = cr.left + cr.width / 2;
        const cp = Math.max(0, 1 - Math.abs(center - innerWidth / 2) / (innerWidth / 2));
        card.style.setProperty('--ps', (0.92 + 0.08 * cp).toFixed(4));
      }
    });
  }
</script>
