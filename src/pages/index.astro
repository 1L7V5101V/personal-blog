---
import Base from '../layouts/Base.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);
const featured = posts.slice(0, 2);
const fmt = (d: Date) => `${d.getFullYear()}.${String(d.getMonth() + 1).padStart(2, '0')}.${String(d.getDate()).padStart(2, '0')}`;
---
<Base>
  <!-- 整页横向 journey：垂直滚动驱动整条轨道（瑞士海报风） -->
  <section class="journey" id="journey">
    <div class="stage">
      <!-- 粗管曲线层（Lusion 形态：大弧+环绕，滚动分段描绘） -->
      <svg class="hline" viewBox="0 0 1600 900" preserveAspectRatio="none" aria-hidden="true">
        <path
          pathLength="1"
          style="stroke-dasharray: 1; stroke-dashoffset: 1;"
          d="M -80 520 C 180 260, 520 180, 760 330 C 980 470, 860 760, 620 800 C 380 840, 140 700, -60 620"
        ></path>
        <path
          pathLength="1"
          style="stroke-dasharray: 1; stroke-dashoffset: 1;"
          d="M 980 -60 C 920 220, 1380 340, 1400 560 C 1415 730, 1240 860, 1660 940"
        ></path>
        <path
          pathLength="1"
          style="stroke-dasharray: 1; stroke-dashoffset: 1;"
          d="M 1240 -80 C 1060 240, 1520 420, 1330 660 C 1180 850, 1020 880, 1120 980"
        ></path>
      </svg>

      <!-- 流体层：鼠标指尖划过出彩虹烟（vendor 自 PavelDoGreat/WebGL-Fluid-Simulation, MIT） -->
      <canvas id="fluid" aria-hidden="true"></canvas>

      <div class="track">
        <!-- 1 · Hero：白卡 + 阶梯缩进 + 黄圆 -->
        <section class="slot heroeslot">
          <a class="hero-card" href="/blog/">
            <span class="dot" style="width: 68%; right: -8%; top: 50%; transform: translateY(-50%);"></span>
            <div class="hero-text">
              <span class="lname"><span class="mask"><span data-reveal style="--i:0">il7510n</span></span></span>
              <span class="line s1"><span class="mask"><span data-reveal style="--i:1">写代码，也写字。</span></span></span>
              <span class="line s2"><span class="mask"><span data-reveal style="--i:2">这里放慢一点，</span></span></span>
              <span class="line s3"><span class="mask"><span data-reveal style="--i:3">想清楚一点。</span></span></span>
            </div>
          </a>
          <p class="hero-hint" data-reveal style="--i:4">向下滚动，整页向右 →</p>
        </section>

        <!-- 2 · 图片卡（悬停虚化） -->
        {featured.map((p, i) => (
          <div class="slot">
            <span class="tag">{String(i + 1).padStart(2, '0')} · {p.data.tag}</span>
            <a class="hcard" href={`/blog/${p.id}/`}>
              <figure>
                <div class="imgbox">
                  {p.data.cover && <img src={p.data.cover} alt="" loading="lazy" />}
                </div>
                <figcaption>
                  <span class="t">{p.data.title}</span>
                  <span class="d">{fmt(p.data.date)}</span>
                  <span class="go">→</span>
                </figcaption>
              </figure>
            </a>
          </div>
        ))}

        <!-- 3 · 字体海报卡（巨型裁切文字 + 色块圆；过中心后爆发加速） -->
        <div class="slot pslot">
          <span class="tag">为什么我又开始写博客了</span>
          <a class="poster" href="/blog/why-blog-again/">
            <span class="dot pdot" style="width: 46%; right: 7%; top: 9%;"></span>
            <span class="pword">写</span>
            <span class="psub">收藏夹越来越厚，写出来的越来越少。</span>
          </a>
        </div>
        <div class="slot pslot">
          <span class="tag">把 Lusion 的滑动效果拆开看</span>
          <a class="poster" href="/blog/deconstruct-lusion-scroll/">
            <span class="dot dot-orange pdot" style="width: 46%; right: 7%; top: 9%;"></span>
            <span class="pword">拆</span>
            <span class="psub">幕帘、缩放、描线——全是基础功。</span>
          </a>
        </div>
        <div class="slot pslot">
          <span class="tag">惯性滚动的手感是怎么调出来的</span>
          <a class="poster" href="/blog/lenis-smooth-scroll/">
            <span class="dot pdot" style="width: 42%; right: 6%; top: 12%;"></span>
            <span class="pword">100%</span>
            <span class="psub">动效全手写 · 零现成模板</span>
          </a>
        </div>

        <!-- 4 · 全部文章：白卡 -->
        <section class="slot listpanel">
          <span class="tag">全部文章 · {posts.length} 篇</span>
          <div class="listpanel-card">
            <div class="list">
              {posts.map((p, i) => (
                <a class="row" href={`/blog/${p.id}/`}>
                  <span class="t">{p.data.title}</span>
                  <span class="m">{p.data.tag} · {fmt(p.data.date)}</span>
                </a>
              ))}
            </div>
          </div>
        </section>

        <!-- 5 · 宣言：直接写在画布上 -->
        <section class="panel manifesto">
          <p data-io style="--i:0">把字写清楚。</p>
          <p data-io style="--i:1">把代码写简单。</p>
          <p data-io style="--i:2">把东西做久。</p>
        </section>

        <!-- 6 · 到头了 -->
        <section class="panel endpanel">
          <p class="big" data-io style="--i:0">到头了。</p>
          <p data-io style="--i:1">
            去 <a class="u" href="/blog/">/blog</a> 逐篇读，
            或者 <button class="u" data-copy="hi@il7510n.dpdns.org">复制邮箱</button> 聊聊。
          </p>
        </section>
      </div>
    </div>
  </section>
</Base>

<script>
  const journey = document.querySelector<HTMLElement>('.journey');
  const track = document.querySelector<HTMLElement>('.track');
  const curvePaths = [...document.querySelectorAll<SVGPathElement>('.hline path')];
  const posters = [...document.querySelectorAll<HTMLElement>('.pslot')];
  const mobile = matchMedia('(max-width: 768px)');
  const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;

  // 流体模拟：仅桌面加载（vendor 自 WebGL-Fluid-Simulation，MIT）
  if (!mobile.matches && !reduced.matches) {
    import('../scripts/fluid.js');
  }

  if (journey && track && !mobile.matches && !reduced) {
    const UNFOLD_DIST = 1800;   // 开场扇子放平占用的滚动距离（此间轨道 Hold 不动）
    let dist = 0;
    const measure = () => {
      dist = Math.max(0, track.scrollWidth - innerWidth);
      journey.style.height = `calc(100svh + ${dist + UNFOLD_DIST}px)`;
    };
    measure();
    addEventListener('resize', measure);
    addEventListener('load', measure);

    // 三条曲线各自的描绘区间（占总滚动进度的比例）
    const phases = [
      [0.0, 0.45],
      [0.15, 0.7],
      [0.35, 1.0],
    ];

    // 开场牌堆（S=0 居中一张、底下随机角度+微偏移堆叠，滚动平移展开）+ 滚轴变形
    const fanEls = [...track.querySelectorAll(':scope > .slot')];
    const N = fanEls.length;
    let prevStrack = 0, vSmooth = 0;
    let slotY = 0, slotH = 0, slotW = 0;
    const measureFan = () => {
      const r0 = fanEls[0]?.getBoundingClientRect();
      if (r0) { slotY = r0.top; slotH = r0.height; slotW = r0.width; }
    };
    measureFan();
    addEventListener('resize', () => { if (scrollY < 2) measureFan(); });
    const easeInOut = (t: number) => {
      const x = Math.max(0, Math.min(1, t));
      return x < 0.5 ? 4 * x * x * x : 1 - Math.pow(-2 * x + 2, 3) / 2;
    };
    // 牌堆位形：随机角度/偏移（每次加载洗一次牌）；顶牌 hero 不旋转、正中
    const pilePose = fanEls.map(() => ({
      r: Math.random() * 14 - 7,     // -7° ~ 7°
      x: Math.random() * 64 - 32,    // ±32px
      y: Math.random() * 40 - 20,    // ±20px
    }));
    pilePose[0] = { r: 0, x: 0, y: 0 };
    // 瀑布落牌：牌按次序从堆里逐张落下归位（0=同时，1=完全串行）
    const STAGGER = 0.55;

    (window as any).__fx = (window as any).__fx || [];
    (window as any).__fx.push(() => {
      const r = journey.getBoundingClientRect();
      const S = Math.max(0, -r.top);
      // 展开期（前 UNFOLD_DIST）轨道 Hold 不动，铺平完成后 conveyor 才启动
      const STrack = Math.max(0, S - UNFOLD_DIST);
      const p = dist > 0 ? Math.min(1, STrack / dist) : 0;

      // 整条轨道：放平完成后，垂直滚动进度 → 水平位移
      track.style.transform = `translate3d(${(-STrack).toFixed(2)}px, 0, 0)`;

      // 曲线描绘：三条按各自区间先后画出来
      curvePaths.forEach((path, i) => {
        const [a, b] = phases[i];
        const lp = Math.min(1, Math.max(0, (p - a) / (b - a)));
        path.style.strokeDashoffset = String(1 - lp);
      });

      // 滚轴变形：视觉滚动速度 → 卡片斜切（快速拨滚轮时像滚轴卷过）
      const v = STrack - prevStrack; prevStrack = STrack;
      vSmooth += (v - vSmooth) * 0.12;
      const skew = Math.max(-7, Math.min(7, vSmooth * 0.05));

      // 开场牌堆：S=0 居中一张卡、底下随机角度+微偏移堆叠；滚动 = 平移展开回轨道，牌不缩放
      const flyRaw = Math.max(0, Math.min(1, S / UNFOLD_DIST));
      const flyPe = easeInOut(flyRaw);
      const cx = innerWidth / 2, cy = innerHeight / 2;

      fanEls.forEach((el, i) => {
        // 瀑布落牌：顶牌先落，后面逐张跟着（级联时序）
        const t0 = (i / (N - 1)) * STAGGER;
        const flyPe = easeInOut((flyRaw - t0) / (1 - STAGGER));
        if (flyRaw >= 0.999) {
          // 完全铺平后回归中性 transform（只留滚轴斜切）
          if (el.style.transformOrigin) { el.style.transformOrigin = ''; el.style.zIndex = ''; }
          el.style.transform = `skewX(${skew.toFixed(2)}deg)`;
          const tg = el.querySelector<HTMLElement>('.tag');
          if (tg) tg.style.opacity = '';
          return;
        }
        const pp = pilePose[i];
        const naturalX = el.offsetLeft - STrack;
        const tx = (cx - slotW / 2 + pp.x - naturalX) * (1 - flyPe);
        const ty = (cy - slotH / 2 + pp.y - slotY) * (1 - flyPe);
        el.style.transformOrigin = '50% 50%';
        el.style.zIndex = String(20 + (N - i)); // hero 最上
        el.style.transform =
          `translate3d(${tx.toFixed(1)}px, ${ty.toFixed(1)}px, 0) rotate(${(pp.r * (1 - flyPe)).toFixed(2)}deg) skewX(${skew.toFixed(2)}deg)`;
        // 小标签跟着牌落定：铺平后才显形
        const tg = el.querySelector<HTMLElement>('.tag');
        if (tg) tg.style.opacity = String(Math.max(0, (flyPe - 0.6) / 0.4));
      });

      // 海报卡内部字体平移：卡片进入视野开始，到达视口中心时滑到末位，之后冻结
      for (const el of posters) {
        const word = el.querySelector<HTMLElement>('.pword');
        if (!word) continue;
        const w = el.offsetWidth;
        const left = el.offsetLeft; // 布局位置（相对 track，不受 transform 影响）
        const sEnter = left - innerWidth;
        const sCenter = left + w / 2 - innerWidth / 2;
        const prog = sCenter > sEnter ? Math.min(1, Math.max(0, (STrack - sEnter) / (sCenter - sEnter))) : 1;
        word.style.transform = `translateX(calc(-50% + ${((0.10 - 0.26 * prog) * w).toFixed(1)}px))`;
      }

      // 首帧就位后揭开轨道（消除刷新闪烁）
      journey.classList.add('fx-ready');
    });
  }
</script>
