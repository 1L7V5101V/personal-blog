---
import Base from '../layouts/Base.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);
const featured = posts.slice(0, 4);
const fmt = (d: Date) => `${d.getFullYear()}.${String(d.getMonth() + 1).padStart(2, '0')}.${String(d.getDate()).padStart(2, '0')}`;
---
<Base>
  <!-- 整页横向 journey：垂直滚动驱动整条轨道，全部内容在一根轴上 -->
  <section class="journey" id="journey">
    <div class="stage">
      <svg class="hline" viewBox="0 0 1600 900" preserveAspectRatio="none" aria-hidden="true">
        <path
          pathLength="1"
          style="stroke-dasharray: 1; stroke-dashoffset: 1;"
          d="M -20 640 C 260 500, 520 780, 820 610 S 1240 430, 1640 580"
        ></path>
      </svg>

      <div class="track">
        <!-- 1 · Hero -->
        <section class="panel hero">
          <span class="label" data-reveal style="--i:0">il7510n · 个人博客</span>
          <h1><span class="mask"><span data-reveal style="--i:1">il7510n</span></span></h1>
          <p class="bio"><span class="mask"><span data-reveal style="--i:2">写代码，也写字。这里放慢一点，想清楚一点。</span></span></p>
          <p class="hint" data-reveal style="--i:3">向下滚动，整页向右 →</p>
        </section>

        <!-- 2 · 图片卡 -->
        {featured.map((p, i) => (
          <a class="hcard" data-io style={`--i:${i}`} href={`/blog/${p.id}/`}>
            <figure>
              <div class="imgbox">
                {p.data.cover && <img src={p.data.cover} alt="" loading="lazy" />}
              </div>
              <figcaption>
                <span class="t">{p.data.title}</span>
                <span class="d">{fmt(p.data.date)}</span>
                <span class="go">→</span>
              </figcaption>
            </figure>
          </a>
        ))}

        <!-- 3 · 纯文字卡（过中心后加速滑向末尾） -->
        <a class="tcard" data-speed href="/blog/why-blog-again/">
          <span class="tin" data-io style="--i:0">
            <span class="q">“</span>
            <p class="big">收藏夹越来越厚，<br/>写出来的越来越少。</p>
            <span class="sub">为什么我又开始写博客了 →</span>
          </span>
        </a>
        <a class="tcard" data-speed href="/blog/deconstruct-lusion-scroll/">
          <span class="tin" data-io style="--i:0">
            <span class="q">“</span>
            <p class="big">Lusion 玄吗？<br/>拆开全是基础功。</p>
            <span class="sub">把 Lusion 的滑动效果拆开看 →</span>
          </span>
        </a>
        <a class="tcard" data-speed href="/blog/lenis-smooth-scroll/">
          <span class="tin" data-io style="--i:0">
            <p class="stat">100<span>%</span></p>
            <p class="big">动效全手写，<br/>零现成模板。</p>
            <span class="sub">惯性滚动的手感是怎么调出来的 →</span>
          </span>
        </a>

        <!-- 4 · 全部文章 -->
        <section class="panel listpanel">
          <span class="label" data-io style="--i:0">全部文章</span>
          <div class="list">
            {posts.map((p, i) => (
              <a class="row" data-io style={`--i:${i % 4}`} href={`/blog/${p.id}/`}>
                <span class="t">{p.data.title}</span>
                <span class="m">{p.data.tag} · {fmt(p.data.date)}</span>
              </a>
            ))}
          </div>
        </section>

        <!-- 5 · 宣言 -->
        <section class="panel manifesto">
          <p data-io style="--i:0">把字写清楚。</p>
          <p data-io style="--i:1">把代码写简单。</p>
          <p data-io style="--i:2">把东西做久。</p>
        </section>

        <!-- 6 · 到头了 -->
        <section class="panel endpanel">
          <p class="big" data-io style="--i:0">到头了。</p>
          <p data-io style="--i:1">
            去 <a class="u" href="/blog/">/blog</a> 逐篇读，
            或者 <button class="u" data-copy="hi@il7510n.dpdns.org">复制邮箱</button> 聊聊。
          </p>
        </section>
      </div>
    </div>
  </section>
</Base>

<script>
  const journey = document.querySelector<HTMLElement>('.journey');
  const track = document.querySelector<HTMLElement>('.track');
  const curve = document.querySelector<SVGPathElement>('.hline path');
  const photoCards = [...document.querySelectorAll<HTMLElement>('.hcard')];
  const fastCards = [...document.querySelectorAll<HTMLElement>('[data-speed]')];
  const mobile = matchMedia('(max-width: 768px)');
  const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (journey && track && !mobile.matches && !reduced) {
    let dist = 0;
    const measure = () => {
      dist = Math.max(0, track.scrollWidth - innerWidth);
      journey.style.height = `calc(100svh + ${dist}px)`;
    };
    measure();
    addEventListener('resize', measure);
    addEventListener('load', measure);

    const SPEED = 1.8;      // 纯文字卡相对轨道的速度倍率
    const MAX_EXTRA = 640;  // 加速位移上限（保证完全滑出屏幕）
    const LERP = 0.12;      // 追赶平滑度
    const state = fastCards.map(() => ({ cur: 0 }));

    (window as any).__fx = (window as any).__fx || [];
    (window as any).__fx.push(() => {
      const r = journey.getBoundingClientRect();
      const S = Math.min(dist, Math.max(0, -r.top));
      const p = dist > 0 ? S / dist : 0;

      // 整条轨道：垂直滚动进度 → 水平位移
      track.style.transform = `translate3d(${(-S).toFixed(2)}px, 0, 0)`;

      // 曲线描绘：滚多少画多少
      if (curve) curve.style.strokeDashoffset = String(1 - p);

      // 纯文字卡：整卡完全离开视口中心后以 SPEED 倍爆发加速，lerp 追赶滑向末尾
      fastCards.forEach((el, i) => {
        const layoutCenter = el.offsetLeft + el.offsetWidth / 2;      // 布局位置（不受 transform 影响）
        const fullyPastAt = layoutCenter + el.offsetWidth / 2 - innerWidth / 2; // 尾边越过中心点所需的轨道位移
        const target = Math.max(0, Math.min((S - fullyPastAt) * (SPEED - 1), MAX_EXTRA));
        const st = state[i];
        st.cur += (target - st.cur) * LERP;
        el.style.setProperty('--extra', `${st.cur.toFixed(1)}px`);
      });

      // 图片卡呼吸缩放：距视口中心越近越饱满
      for (const card of photoCards) {
        const cr = card.getBoundingClientRect();
        if (cr.right < 0 || cr.left > innerWidth) continue;
        const center = cr.left + cr.width / 2;
        const cp = Math.max(0, 1 - Math.abs(center - innerWidth / 2) / (innerWidth / 2));
        card.style.setProperty('--ps', (0.95 + 0.05 * cp).toFixed(4));
      }
    });
  }
</script>
