---
// 顶部心电图。两种模式：
//
//  fill（默认，文章页 / 列表页 / 关于页）：阅读进度条。滚动越深，心跳波形画得越完整。
//  路径在构建期生成，一整条线上平铺 N 个完整心动周期，用 stroke-dashoffset 描。
//
//  strip（首页）：走纸式。一拍 = 一张卡，R 峰就画在那张卡的正上方。
//  横条本身是 `left:0;right:0` 的固定层，所以它的 x 轴和屏幕 1:1 —— 峰位不需要任何换算，
//  窗口多宽都一样。波形建在**轨道坐标**里（每拍的 R 峰 = 那张卡的中心 x），整条纸带
//  每帧按 -STrack 平移，和卡片走的是同一个位移。中间那条「现在线」= 屏幕中心：
//  一张卡滑到屏心 = 它那一拍正好滑过现在线，左边是已经打过的（亮），右边是还没打的（暗）。
//  首页在 measureFan/resize 时调 `__ecgStrip.build(卡中心[], 屏心px)`，每帧调 `move(STrack)`。
//
// 形态按真实心电图走：每个周期 = 平段 → P 波（低丘）→ PR 段 → Q 小下探
// → R 主冲 → S 探底 → 回基线 → T 波（宽丘）→ U 波（微隆）。
// QRS 用折线（真机就是尖的），P / T / U 用二次贝塞尔。
//
// 「细化」落在四处，都是真机特征：
//   ① 每拍 R 峰幅度有起伏（真实的窦性心律本来就不等幅）
//   ② R 峰上冲比回落快（收缩期去极化快于复极化）
//   ③ T 波后面跟一个小 U 波
//   ④ 基线有一条超低频的漂移，不是死平的
// 全部用固定种子的线性同余，不用 Math.random —— 构建产物必须可复现。
interface Props { mode?: 'fill' | 'strip' }
const { mode = 'fill' } = Astro.props;

const W = 1600, H = 40, BASE = 26, N = 22, SEG = W / N;
const PEAK = 0.655;   // R 峰在一拍内的横向位置（拍内归一）—— 两种模式共用同一个比例

let seed = 20260920;
const rnd = () => ((seed = (seed * 1103515245 + 12345) & 0x7fffffff) / 0x7fffffff - 0.5);
const f = (n: number) => n.toFixed(2);
const j = (amp: number) => rnd() * 2 * amp;   // 抖动量

// 基线漂移：一条超低频正弦 + 一点随机，幅度很小（真机的基线就轻微飘）
const drift = (x) => Math.sin(x * 0.0042) * 0.55 + j(0.5);

// 一整个心动周期。x = 该周期的起点
const beat = (x) => {
  const at = (k) => x + SEG * k;
  const y = (k) => BASE + drift(x + SEG * k);
  // 每拍 R 峰幅度 ±9%：真实心律的不等幅
  const rTop = y(0.67) - (19 + j(1.8)) * (1 + rnd() * 0.09);
  return [
    `L ${f(at(0.12))} ${f(y(0.12))}`,                       // 基线平路
    `L ${f(at(0.30))} ${f(y(0.30))}`,
    `Q ${f(at(0.39))} ${f(y(0.39) - 3.6)} ${f(at(0.48))} ${f(y(0.48))}`,   // P 波
    `L ${f(at(0.58))} ${f(y(0.58))}`,                       // PR 段
    `L ${f(at(0.605))} ${f(y(0.605) + 2.6)}`,               // Q 下探
    `L ${f(at(PEAK))} ${f(rTop)}`,                          // R 急冲（上冲快）
    `L ${f(at(0.685))} ${f(rTop + (y(0.685) - rTop) * 0.42)}`,  // 回落稍缓
    `L ${f(at(0.73))} ${f(y(0.73) + 7)}`,                   // S 探底
    `L ${f(at(0.79))} ${f(y(0.79))}`,                       // 回基线
    `Q ${f(at(0.875))} ${f(y(0.875) - 6.5)} ${f(at(0.945))} ${f(y(0.945))}`,   // T 波
    `Q ${f(at(0.968))} ${f(y(0.968) - 1.7)} ${f(at(1.0))} ${f(y(1.0))}`,       // U 波
  ].join(' ');
};

let d = `M 0 ${f(BASE + drift(0))}`;
for (let i = 0; i < N; i++) d += ` ${beat(i * SEG)}`;
d += ` L ${W} ${f(BASE + drift(W))}`;   // 收尾补一小段平路
---
<div class="ecg" aria-hidden="true">
  <div class="ecg-fill">
    <svg viewBox={`0 0 ${W} ${H}`} preserveAspectRatio="none">
      <path class="bg" d={d}></path>
      <path class="fg" d={d} pathLength="1" style="stroke-dasharray: 1; stroke-dashoffset: 1;"></path>
    </svg>
  </div>
  {mode === 'strip' && (
    <div class="ecg-strip">
      <!-- 没有 viewBox：用户坐标就是 CSS px，和屏幕 1:1。
           两层 .mv 吃同一个 translateX（bg 整条都画，fg 只留现在线左边那半）-->
      <svg>
        <defs>
          <clipPath id="ecg-now" clipPathUnits="userSpaceOnUse">
            <rect x="0" y="0" width="0" height="46"></rect>
          </clipPath>
        </defs>
        <g class="mv"><path class="bg"></path></g>
        <g clip-path="url(#ecg-now)"><g class="mv"><path class="fg"></path></g></g>
        <line class="now-line" x1="0" x2="0" y1="7" y2="41"></line>
      </svg>
    </div>
  )}
</div>

<script>
  const box = document.querySelector<HTMLElement>('.ecg');
  const fg = box?.querySelector<SVGPathElement>('.ecg-fill .fg');
  if (box && fg) {
    window.__fx = window.__fx || [];
    // scrollHeight 是布局相关的读：放在每帧开头会把上一帧攒下的样式失效刷成一次
    // 全量重算 + 布局，然后下一帧再来一遍。这里改成事件驱动地量。
    let max = 0;
    let lastOff = '';
    const measure = () => { max = document.documentElement.scrollHeight - innerHeight; };
    measure();
    addEventListener('resize', measure);
    addEventListener('load', measure);
    document.fonts?.ready.then(measure);
    // 写作页重新排版会让文档变高，ResizeObserver 是事件驱动的，不用每帧去问
    if (typeof ResizeObserver !== 'undefined') new ResizeObserver(measure).observe(document.documentElement);
    window.__fx.push(() => {
      // 首页走纸式建成后 fill 层被 .ecg-is-strip 藏起来了，没必要再描它；
      // 但移动端 / 减动效下 build() 永不发生，fill 层就是那根可见的进度条 —— 所以判断挂在类上，
      // 不能挂在「标记里有没有走纸层」上，否则会把那条兜底一起删掉。
      if (box.classList.contains('ecg-is-strip')) return;
      const p = max > 0 ? Math.min(1, Math.max(0, scrollY / max)) : 0;
      const v = (1 - p).toFixed(3);
      if (v === lastOff) return;   // strokeDashoffset 是绘制属性：值没变就别让它重绘
      lastOff = v;
      fg.style.strokeDashoffset = v;
    });
  }

  // 走纸式（首页）：波形在运行时按卡的实际版位建，纸带每帧跟着轨道平移
  const strip = box?.querySelector<HTMLElement>('.ecg-strip');
  if (strip) {
    const mvs = [...strip.querySelectorAll<SVGGElement>('.mv')];
    const paths = [...strip.querySelectorAll<SVGPathElement>('path')];
    const nowRect = strip.querySelector<SVGRectElement>('rect');
    const nowLine = strip.querySelector<SVGLineElement>('.now-line');

    const BASE = 30, BEAT_W = 170, PEAK = 0.655;   // px；幅度 = fill 那套 ×1.15（.ecg 高 46 / viewBox 40）
    let seed = 20260920;
    const rnd = () => ((seed = (seed * 1103515245 + 12345) & 0x7fffffff) / 0x7fffffff - 0.5);
    const f = (n: number) => n.toFixed(2);
    const j = (amp: number) => rnd() * 2 * amp;
    const drift = (x: number) => Math.sin(x * 0.002) * 0.7 + j(0.4);
    // 一整个心动周期，R 峰正好落在 cx 上（cx = 那张卡在轨道坐标里的中心）
    const beat = (cx: number) => {
      const at = (k: number) => cx - PEAK * BEAT_W + BEAT_W * k;
      const y = (k: number) => BASE + drift(at(k));
      const rTop = y(0.67) - (22 + j(2)) * (1 + rnd() * 0.09);
      return [
        `L ${f(at(0.12))} ${f(y(0.12))}`,
        `L ${f(at(0.30))} ${f(y(0.30))}`,
        `Q ${f(at(0.39))} ${f(y(0.39) - 4.1)} ${f(at(0.48))} ${f(y(0.48))}`,   // P
        `L ${f(at(0.58))} ${f(y(0.58))}`,                                      // PR
        `L ${f(at(0.605))} ${f(y(0.605) + 3)}`,                                // Q
        `L ${f(at(PEAK))} ${f(rTop)}`,                                         // R
        `L ${f(at(0.685))} ${f(rTop + (y(0.685) - rTop) * 0.42)}`,             // 回落
        `L ${f(at(0.73))} ${f(y(0.73) + 8)}`,                                  // S
        `L ${f(at(0.79))} ${f(y(0.79))}`,
        `Q ${f(at(0.875))} ${f(y(0.875) - 7.5)} ${f(at(0.945))} ${f(y(0.945))}`,   // T
        `Q ${f(at(0.968))} ${f(y(0.968) - 2)} ${f(at(1.0))} ${f(y(1.0))}`,         // U
      ].join(' ');
    };
    const build = (xs: number[], nowPx: number) => {
      if (!xs.length) return;
      const lead = Math.max(innerWidth, 1200) + BEAT_W;   // 两端的空基线：保证纸带永远盖满横条
      let d = `M ${f(xs[0] - lead)} ${f(BASE)}`;
      for (const cx of xs) d += ` L ${f(cx - PEAK * BEAT_W)} ${f(BASE)} ${beat(cx)}`;
      d += ` L ${f(xs[xs.length - 1] + lead)} ${f(BASE)}`;
      for (const p of paths) p.setAttribute('d', d);
      nowRect.setAttribute('width', String(nowPx));
      nowLine.setAttribute('x1', String(nowPx));
      nowLine.setAttribute('x2', String(nowPx));
      box.classList.add('ecg-is-strip');
    };
    const move = (S: number) => {
      const t = `translateX(${(-S).toFixed(2)}px)`;
      for (const g of mvs) g.style.transform = t;
    };
    (window as any).__ecgStrip = { build, move };
  }
</script>
