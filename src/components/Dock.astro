---
// 底部 dock：三个常驻入口（Rauno 式）。aria-current 由各页面传入的 path 决定。
const { path = '/' } = Astro.props;
const items = [
  { href: '/', label: '首页', test: (p: string) => p === '/',
    icon: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M3 10.5 12 3l9 7.5"/><path d="M5 9.5V21h14V9.5"/></svg>' },
  { href: '/blog/', label: '文章', test: (p: string) => p.startsWith('/blog'),
    icon: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><path d="M4 5h16M4 12h16M4 19h10"/></svg>' },
  { href: '/about/', label: '关于', test: (p: string) => p.startsWith('/about'),
    icon: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><circle cx="12" cy="8" r="4"/><path d="M4 21c1.5-4 4.5-6 8-6s6.5 2 8 6"/></svg>' },
];
---
<div class="dock">
  {items.map((it) => (
    <a href={it.href} aria-label={it.label} title={it.label} aria-current={it.test(path) ? 'page' : undefined} set:html={it.icon} />
  ))}
</div>
