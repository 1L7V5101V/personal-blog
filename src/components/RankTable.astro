---
import { COS, ROWS } from '../data/six-ranking';

// 数据硬校验（构建/开发时都会跑）：六家频次之和 = 总频次、非 0 公司数 = 家数。
// 录错一行这里直接抛错，别放着让错数据安静上线。
for (const r of ROWS) {
  const cells = [r[3], r[4], r[5], r[6], r[7], r[8]];
  const sum = cells.reduce((s, c) => s + (c ? c[0] : 0), 0);
  const n = cells.filter((c) => c !== 0).length;
  if (sum !== r[9] || n !== r[10]) {
    throw new Error(`六家综合排行第 ${r[0]} 名「${r[1]}」对不上：频次和 ${sum} ≠ 总频次 ${r[9]}，或上榜数 ${n} ≠ 家数 ${r[10]}`);
  }
}

// 题号前缀（"146." / "剑指Offer22." / "补充题4."）单独拎出来淡一档
function splitTitle(t: string): [string | null, string] {
  const i = t.indexOf('. ');
  return i > 0 ? [t.slice(0, i + 1), t.slice(i + 2)] : [null, t];
}
---
<div class="scroll">
  <table class="rank">
    <thead>
      <tr>
        <th class="num">排名</th>
        <th>题目</th>
        <th>Hot100</th>
        {COS.map((c) => <th class="num">{c}</th>)}
        <th class="num">总频次</th>
        <th class="num">家数</th>
      </tr>
    </thead>
    <tbody>
      {ROWS.map((r) => {
        const cells = [r[3], r[4], r[5], r[6], r[7], r[8]];
        const [no, name] = splitTitle(r[1]);
        return (
          <tr>
            <td class="num">{r[0]}</td>
            <td class="ttl">{no && <span class="no">{no}</span>}{name}</td>
            <td class={r[2] ? 'hot' : 'hot off'}>{r[2] ? '是' : '否'}</td>
            {cells.map((c) =>
              c ? (
                <td class="num">{c[0]}<span class="pr">({c[1]})</span></td>
              ) : (
                <td class="num off">—</td>
              )
            )}
            <td class="num total">{r[9]}</td>
            <td class="num">{r[10]}</td>
          </tr>
        );
      })}
    </tbody>
  </table>
</div>
<p class="fine">共 {ROWS.length} 题。原表到第 70 名截断，往后的名次没有录。</p>

<style>
  /* 表比正文密：字号收到 0.86rem，内边距收紧，数字列右对齐。
     ⚠ .prose 的全局规则给第二列（题目）加了 nowrap —— 那是给术语表的，
     这里必须翻回 normal，长题目才能折行（.rank .ttl + scoped 属性比它高一级）。 */
  .rank { font-size: 0.86rem; }
  .rank th,
  .rank td { padding: 0.42em 0.5em; }
  .rank .ttl { white-space: normal; }
  .rank .num { text-align: right; font-variant-numeric: tabular-nums; }
  .rank th.num { text-align: right; }
  .rank .no { color: var(--ink-3); font-size: 0.82em; margin-right: 0.45em; }
  .rank .pr { color: var(--ink-3); font-size: 0.78em; margin-left: 0.15em; }
  .rank .off { color: var(--ink-3); }
  .rank .total { color: var(--ink); font-weight: 650; }
  .rank tbody tr:hover { background: color-mix(in srgb, var(--ink) 5%, transparent); }

  /* 纸面左右各留 20%，中间装不下 11 列的窄屏让表横滚 */
  .scroll { overflow-x: auto; }
  .rank { min-width: 44rem; }

  .fine { color: var(--ink-3); font-size: 0.92rem; }
</style>
