---
import '../styles/global.css';
import EcgProgress from '../components/EcgProgress.astro';

interface Props {
  title?: string;
  description?: string;
  /** 顶部心电图模式：'fill' = 阅读进度条（默认）；'strip' = 走纸式，一拍画在一张卡正上方（首页） */
  ecgMode?: 'fill' | 'strip';
  /** 当前页的路径。about.astro 和 blog/[slug].astro 早就在传这个属性了，
      但 Props 里没声明、也没人读 —— 「你在哪一段」这个钩子等于设计了却没接线。 */
  path?: string;
}
const { title = 'il7510n', description = 'il7510n 的个人博客', ecgMode, path = Astro.url.pathname } = Astro.props;
const EMAIL = 'hi@il7510n.dpdns.org';
const NAV = [
  { href: '/blog/', label: '文章' },
  { href: '/columns/', label: '栏目' },
  { href: '/about/', label: '关于' },
];
---
<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><text y='.9em' font-size='90'>🤍</text></svg>" />
  </head>
  <body>
    <!-- 鼠标光晕：指针处一团红光，全站一层，垫在内容之下（只照黑场）。
         位置每帧由 mouse-light 写 transform（样式见 global.css 的 .mouselight）。 -->
    <div class="mouselight" aria-hidden="true"></div>

    <!-- 顶部遮罩：最上面实底、往下渐变透明，带一点模糊。
         给 ECG 和顶栏文字一条干净的「顶棚」，正文从底下化出来。
         ⚠ 高度要短（76px）：backdrop-filter 每帧都要对背板重新模糊，
         铺满一屏就是每帧重算全屏栅格 —— 项目里 dock 的 backdrop-filter
         就是因为这个删掉的。这条只覆盖顶部一条窄带。 -->
    <div class="topveil" aria-hidden="true"></div>

    <nav class="topnav">
      {/* logo 也走 .u：顶栏所有链接的反馈都是同一套（变白 + 下划线展开），
          它以前没带这个类，于是「回首页」这个链接什么都不响应 */}
      <a class="logo u" href="/">il7510n</a>
      <div class="links">
        {NAV.map((n) => (
          <a
            class:list={['u', { 'is-current': path.startsWith(n.href) }]}
            href={n.href}
            aria-current={path.startsWith(n.href) ? 'page' : undefined}
          >
            {n.label}
          </a>
        ))}
        <button class="u" data-copy={EMAIL} style="background:none;border:none;color:inherit;font:inherit;cursor:pointer">{EMAIL}</button>
      </div>
    </nav>

    <EcgProgress mode={ecgMode} />

    <main>
      <slot />
    </main>

    <footer class="site">
      <span>© 2026 il7510n</span>
    </footer>

    <script>
      import Lenis from 'lenis';
      // 点开卡片 / 返回的整页过渡（模块先于本脚本与各页脚本执行）
      import '../scripts/page-transition';
      // 鼠标光晕：全站一层，指针处的那团红光
      import '../scripts/mouse-light';

      const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;

      // Lenis 惯性滚动（整站统一手感）。
      // ⚠ 隐藏/被遮挡的窗口里 rAF 不跑（ZCode 内置窗格甚至一直报 hidden），
      // Lenis 劫持了滚轮、动画却永远跑不完 —— 滚轮就彻底失灵，正文滚不动。
      // 所以页面不可见时摘掉 Lenis 让位给原生滚动，可见时再建回来
      //（Lenis 构造时会读当前滚动值接管，不会打架）。
      let lenis: Lenis | null = null;
      function makeLenis() {
        lenis = new Lenis({ lerp: 0.12 });
        (window as any).__lenis = lenis;
      }
      function dropLenis() {
        lenis?.destroy();
        lenis = null;
        (window as any).__lenis = null;
      }
      if (!reduced && !document.hidden) {
        makeLenis();
      }
      document.addEventListener('visibilitychange', () => {
        if (reduced) return;
        document.hidden ? dropLenis() : (lenis ?? makeLenis());
      });

      // 统一 rAF：各页面的滚动联动回调都挂到 __fx 上，这里统一驱动。
      // ⚠ 整段 try/catch：这里抛异常会静默杀死 rAF → 全页 fx 死、
      // console 还常常抓不到（uncaught 不进 console API）。
      // 捕获后存到 __fxErrs，循环继续跑，页面不至于整个瘫痪。
      (window as any).__fx = (window as any).__fx || [];
      (window as any).__fxErrs = [];
      function raf(time: number) {
        try {
          lenis?.raf(time);
          for (const f of (window as any).__fx) f();
        } catch (e) {
          const errs = (window as any).__fxErrs;
          if (errs.length < 20) {
            errs.push(
              e instanceof Error ? `${e.message}\n${e.stack}` : String(e),
            );
          }
          console.error('[fx]', e);
        }
        requestAnimationFrame(raf);
      }
      requestAnimationFrame(raf);

      // 进场 stagger
      document.body.classList.add('loaded');

      // 滚动 reveal：进入视口一次性触发
      const io = new IntersectionObserver(
        (entries) => {
          for (const e of entries) {
            if (e.isIntersecting) {
              e.target.classList.add('in');
              io.unobserve(e.target);
            }
          }
        },
        { threshold: 0.15 }
      );
      document.querySelectorAll('[data-io]').forEach((el) => io.observe(el));

      // click-to-copy（Rauno 式状态反馈）
      document.querySelectorAll<HTMLElement>('[data-copy]').forEach((btn) => {
        let timer: ReturnType<typeof setTimeout>;
        // 顶栏是 space-between 的一条：按钮文字从邮箱（20 个字符）换成「已复制 ✓」（5 个），
        // 会把它左边那三个链接一起横推一次、1.5 秒后再推回来，而且改的是宽度不是 transform ——
        // 全站唯一一处「状态变化让邻居滑走」。这里先把量到的宽度钉住（只在建立监听时读一次），
        // 之后两次换字都不挪动别人。
        btn.style.minWidth = `${Math.ceil(btn.getBoundingClientRect().width)}px`;
        btn.addEventListener('click', async () => {
          const email = btn.getAttribute('data-copy') ?? '';
          try { await navigator.clipboard.writeText(email); } catch {}
          const orig = btn.textContent;
          btn.textContent = '已复制 ✓';
          clearTimeout(timer);
          timer = setTimeout(() => (btn.textContent = orig), 1500);
        });
      });
    </script>
  </body>
</html>
